# Baat Cheet Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (include protocol, no trailing slash)
# Development:
VITE_API_URL=http://localhost:9990

# Production examples:
# VITE_API_URL=https://api.baatcheet.com
# VITE_API_URL=https://baatcheet-backend.railway.app
# VITE_API_URL=https://baatcheet-api.onrender.com
