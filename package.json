{
  "name": "baat-cheet",
  "version": "1.0.0",
  "description": "Baat Cheet - Real-time Chat Application",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,worker,frontend\" -c \"blue,magenta,green\" \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:worker": "cd backend && npm run worker:email",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start"
  },
  "keywords": [
    "chat",
    "real-time",
    "socket.io",
    "react",
    "nodejs"
  ],
  "author": "Arush Awasthi",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
